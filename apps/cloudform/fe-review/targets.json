{
  "project": "cloudform",
  "verified": false,
  "verifiedNote": "由原始碼推斷，尚未實際啟動；第一次執行時驗證並修正後改為 true。",
  "locale": "zh-TW",
  "colorSchemes": [
    "light",
    "dark"
  ],
  "apps": [
    {
      "name": "web",
      "kind": "spa",
      "cwd": "apps/cloudform/frontend",
      "install": "npm ci",
      "start": "npm run dev -- --host 127.0.0.1 --port 3000 --strictPort",
      "env": {},
      "baseUrl": "http://127.0.0.1:3000",
      "ready": "/",
      "pages": [
        {
          "id": "home",
          "path": "/"
        },
        {
          "id": "templates",
          "path": "/templates"
        },
        {
          "id": "template-new",
          "path": "/templates/new"
        }
      ]
    }
  ]
}
