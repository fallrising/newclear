{
  "project": "cms-scaffold",
  "verified": false,
  "verifiedNote": "由原始碼推斷，尚未實際啟動；第一次執行時驗證並修正後改為 true。",
  "locale": "zh-TW",
  "colorSchemes": [
    "light",
    "dark"
  ],
  "apps": [
    {
      "name": "web-front",
      "kind": "spa",
      "cwd": "apps/cms-scaffold/apps/web-front",
      "install": "(workspace root) install",
      "start": "npm run dev:mock -- --host 127.0.0.1 --strictPort",
      "env": {},
      "baseUrl": "http://127.0.0.1:5173",
      "ready": "/",
      "pages": [
        {
          "id": "home",
          "path": "/"
        },
        {
          "id": "album",
          "path": "/album"
        },
        {
          "id": "albums",
          "path": "/album/albums"
        },
        {
          "id": "projects",
          "path": "/projects"
        },
        {
          "id": "clinic",
          "path": "/clinic"
        },
        {
          "id": "login",
          "path": "/login"
        }
      ]
    },
    {
      "name": "web-back",
      "kind": "spa",
      "cwd": "apps/cms-scaffold/apps/web-back",
      "install": "(workspace root) install",
      "start": "npm run dev:mock -- --host 127.0.0.1 --strictPort",
      "env": {},
      "baseUrl": "http://127.0.0.1:5174",
      "ready": "/",
      "pages": [
        {
          "id": "login",
          "path": "/login"
        },
        {
          "id": "home",
          "path": "/"
        },
        {
          "id": "album-composer",
          "path": "/views/album.composer"
        },
        {
          "id": "clinic-schedule",
          "path": "/views/clinic.schedule"
        },
        {
          "id": "projects-board",
          "path": "/views/projects.board"
        }
      ]
    },
    {
      "name": "web-admin",
      "kind": "spa",
      "cwd": "apps/cms-scaffold/apps/web-admin",
      "install": "(workspace root) install",
      "start": "npm run dev:mock -- --host 127.0.0.1 --strictPort",
      "env": {},
      "baseUrl": "http://127.0.0.1:5175",
      "ready": "/",
      "pages": [
        {
          "id": "login",
          "path": "/login"
        },
        {
          "id": "home",
          "path": "/"
        },
        {
          "id": "types",
          "path": "/types"
        },
        {
          "id": "users",
          "path": "/users"
        }
      ]
    }
  ]
}
