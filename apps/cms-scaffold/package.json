{
  "name": "cms-scaffold",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:bundle": "node scripts/check-bundles.mjs",
    "measure:bundle": "node --test scripts/measure-bundles.test.mjs && node scripts/measure-bundles.mjs",
    "e2e": "bash e2e/run.sh",
    "e2e:mock": "playwright test --config playwright.mock.config.ts",
    "record:frontend": "node scripts/record-frontend.mjs",
    "measure:vitals": "npm run build && playwright test --config playwright.vitals.config.ts vitals-w5.spec.ts",
    "test:a11y": "playwright test --config playwright.quality.config.ts axe-w5.spec.ts",
    "test:visual": "playwright test --config playwright.quality.config.ts visual-w5.spec.ts",
    "test:hardening": "playwright test --config playwright.quality.config.ts hardening-w5.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
