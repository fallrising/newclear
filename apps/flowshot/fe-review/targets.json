{
  "project": "flowshot",
  "verified": false,
  "verifiedNote": "由原始碼推斷，尚未實際啟動；第一次執行時驗證並修正後改為 true。",
  "locale": "zh-TW",
  "colorSchemes": [
    "light",
    "dark"
  ],
  "apps": [
    {
      "name": "web",
