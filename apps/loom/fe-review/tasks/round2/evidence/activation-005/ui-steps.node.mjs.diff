+// Model the locked XYDrag input contract: startDrag anchors at the first
+// threshold-crossing event, and that event does not move the node. This catches
+// the observed loom004 loss of 688/12 CSS px; it is not a browser PASS claim.
+function thresholdDragPage({ shiftAtObservation = false, unstableActivation = false } = {}) {
+  let docX = 140, nodeX = 60, pointerX = 0, pressX = 0, anchorX = 0;
+  let pressed = false, active = false, evaluations = 0, fits = 0, released = 0;
+  const snapshot = () => ({ stable: !(unstableActivation && pressed), last: {
+    document: { x: docX, width: 560 }, terminal: { x: nodeX, width: 640 },
+    source: { centerHit: nodeX > docX + 560 }, target: { centerHit: true },
+  } });
+  return {
+    async evaluate() {
+      evaluations++;
+      if (shiftAtObservation && pressed) { docX += 20; nodeX += 8; }
+      return snapshot();
+    },
+    locator() { return { async boundingBox() { return { x: nodeX + 20, y: 100, width: 100, height: 20 }; } }; },
+    mouse: {
+      async move(x, _y, { steps = 1 } = {}) {
+        const from = pointerX;
+        for (let i = 1; i <= steps; i++) {
+          const next = from + (x - from) * i / steps;
+          if (pressed) {
+            if (!active && Math.abs(next - pressX) > 1) { active = true; anchorX = next; }
+            if (active) { nodeX += next - anchorX; anchorX = next; }
+          }
+          pointerX = next;
+        }
+      },
+      async down() { pressed = true; pressX = pointerX; active = false; },
+      async up() { pressed = false; released++; },
+    },
+    getByRole() { return { async click() { fits++; } }; },
+    result() { return { gap: nodeX - docX - 560, evaluations, fits, released, pressed }; },
+  };
+}
+test('threshold-consuming drag preserves the measured gap after activation instead of losing its first increment', async () => {
+  const page = thresholdDragPage(), receipt = {};
+  await separateNodes(page, receipt);
+  assert.equal(page.result().gap, 48);
+  assert.equal(page.result().released, 1);
+  assert.equal(page.result().fits, 1);
+});
+test('remaining displacement is recomputed from post-activation geometry', async () => {
+  const page = thresholdDragPage({ shiftAtObservation: true });
+  await separateNodes(page, {});
+  assert.equal(page.result().gap, 48);
+  assert.equal(page.result().evaluations, 3);
+});
+test('unstable activation geometry fails and releases the pointer without performing a full drag', async () => {
+  const page = thresholdDragPage({ unstableActivation: true });
+  await assert.rejects(separateNodes(page, {}), /REVIEW_GEOMETRY_UNSTABLE/);
+  assert.equal(page.result().released, 1);
+  assert.equal(page.result().fits, 0);
+  assert.equal(page.result().pressed, false);
+});
