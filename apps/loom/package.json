{
  "name": "loom",
  "private": true,
  "version": "0.1.0",
  "description": "Loom — AI-native workspace.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck:contracts": "tsc --noEmit -p tsconfig.contracts.json",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "emit-types": "cargo test -p loom-contracts --quiet",
    "test": "vitest run",
    "verify": "npm run emit-types && npm run typecheck:contracts && npm run typecheck:app && npm run test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "^0.10",
    "@xterm/xterm": "^5.5",
    "@xyflow/react": "^12.11.0",
    "react": "^18.3",
    "react-dom": "^18.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@vitejs/plugin-react": "^4.3",
    "typescript": "~5.6.0",
    "vite": "^5.4",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
