+  // A terminal-state-first client, like BodyStreamBuffer::OnStateChange.
+  // It exercises the real delegate; it does not model the loader state machine.
+  class TerminalCleanupClient final
+      : public GarbageCollected<TerminalCleanupClient>,
+        public BytesConsumer::Client {
+   public:
+    TerminalCleanupClient(BytesConsumer& consumer, TestClient& loader_client)
+        : consumer_(consumer), loader_client_(loader_client) {}
+
+    void OnStateChange() override {
+      ++notifications_;
+      EXPECT_EQ(0, loader_client_->TerminalCount());
+      switch (consumer_->GetPublicState()) {
+        case PublicState::kClosed:
+          ++closed_notifications_;
+          consumer_->Cancel();
+          EXPECT_EQ(0, loader_client_->TerminalCount());
+          return;
+        case PublicState::kErrored:
+          ++error_notifications_;
+          consumer_->Cancel();
+          EXPECT_EQ(0, loader_client_->TerminalCount());
+          return;
+        case PublicState::kReadableOrWaiting:
+          break;
+      }
+      while (true) {
+        base::span<const char> buffer;
+        Result result = consumer_->BeginRead(buffer);
+        if (result != Result::kOk) {
+          return;
+        }
+        data_.Append(base::as_bytes(buffer));
+        if (consumer_->EndRead(buffer.size()) != Result::kOk) {
+          return;
+        }
+      }
+    }
+    String DebugName() const override { return "TerminalCleanupClient"; }
+    void Trace(Visitor* visitor) const override {
+      visitor->Trace(consumer_);
+      visitor->Trace(loader_client_);
+      BytesConsumer::Client::Trace(visitor);
+    }
+    int Notifications() const { return notifications_; }
+    int ClosedNotifications() const { return closed_notifications_; }
+    int ErrorNotifications() const { return error_notifications_; }
+    String GetData() { return data_.ToString(); }
+
+   private:
+    const Member<BytesConsumer> consumer_;
+    const Member<TestClient> loader_client_;
+    StringBuilder data_;
+    int notifications_ = 0;
+    int closed_notifications_ = 0;
+    int error_notifications_ = 0;
+  };
+
+  static void ExpectTerminalCounts(const TestClient& client,
+                                   int finish,
+                                   int fail,
+                                   int cancel) {
+    EXPECT_EQ(finish, client.FinishCount());
+    EXPECT_EQ(fail, client.FailCount());
+    EXPECT_EQ(cancel, client.CancelCount());
+  }
+
