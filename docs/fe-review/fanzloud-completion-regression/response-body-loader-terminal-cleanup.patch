+// These tests use public consumer operations and loader-client callbacks.
+// The closed/error cleanup cases specify desired terminal classification;
+// against the pinned original they are expected to fail, but are NOT_RUN.
+TEST_F(ResponseBodyLoaderDrainedBytesConsumerNotificationInOnStateChangeTest,
+       ClosedNotificationCleanupPreservesFinish) {
+  auto task_runner = base::MakeRefCounted<scheduler::FakeTaskRunner>();
+  auto* original = MakeGarbageCollected<ReplayingBytesConsumer>(task_runner);
+  original->Add(Command(Command::kWait));
+  original->Add(Command(Command::kData, "hello"));
+  original->Add(Command(Command::kWait));
+  original->Add(Command(Command::kDone));
+  auto* client = MakeGarbageCollected<TestClient>();
+  auto* loader = MakeResponseBodyLoader(*original, *client, task_runner);
+  BytesConsumer& consumer = loader->DrainAsBytesConsumer();
+  auto* cleanup = MakeGarbageCollected<TerminalCleanupClient>(consumer, *client);
+  consumer.SetClient(cleanup);
+
+  base::span<const char> buffer;
+  ASSERT_EQ(Result::kShouldWait, consumer.BeginRead(buffer));
+  ExpectTerminalCounts(*client, 0, 0, 0);
+  task_runner->RunUntilIdle();
+
+  EXPECT_EQ("hello", cleanup->GetData());
+  EXPECT_EQ("hello", client->GetData());
+  EXPECT_EQ(1, cleanup->ClosedNotifications());
+  EXPECT_EQ(0, cleanup->ErrorNotifications());
+  ExpectTerminalCounts(*client, 1, 0, 0);
+  EXPECT_FALSE(original->IsCancelled());
+  task_runner->RunUntilIdle();
+  ExpectTerminalCounts(*client, 1, 0, 0);
+}
+
