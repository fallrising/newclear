#!/usr/bin/env python3
import os,sys
args=[os.environ['QUAL_MKFK_COMPOSE'] if a=='deploy/compose.yaml' else 'qualification-mkfk:20261021' if a=='mkfk:local' else a for a in sys.argv[1:]]
if args and args[0]=='compose':os.execv(os.environ['QUAL_COMPOSE_TOOL'],[os.environ['QUAL_COMPOSE_TOOL']]+args[1:])
os.execv('/usr/bin/docker',['docker']+args)
