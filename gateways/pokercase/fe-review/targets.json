{
  "project": "pokercase",
  "verified": false,
  "verifiedNote": "第1輪來源核對；DESIGN M1 隔離/新資料/登入fixture尚未實作，不得宣稱受保護頁驗收。",
  "locale": "zh-TW",
  "colorSchemes": [
    "dark"
  ],
  "apps": [
    {
      "name": "admin",
      "kind": "server",
      "cwd": "gateways/pokercase",
      "install": "cargo build",
      "start": "cargo run --locked -- serve --host 127.0.0.1 --port 20128 --data-dir \"${FE_POKER_DATA_DIR:?fresh task data required}\"",
      "env": {},
      "baseUrl": "http://127.0.0.1:20128",
      "ready": "/admin/login",
      "pages": [
        {
          "id": "login",
          "path": "/admin/login"
        },
        {
          "id": "dashboard",
          "path": "/admin"
        },
        {
          "id": "connections",
          "path": "/admin/connections"
        },
        {
          "id": "routes",
          "path": "/admin/routes"
        },
        {
          "id": "keys",
          "path": "/admin/keys"
        },
        {
          "id": "usage",
          "path": "/admin/usage"
        }
      ]
    },
    {
      "name": "tui",
      "kind": "terminal",
      "cwd": "gateways/pokercase",
      "start": "cargo run --locked -- tui --data-dir \"${FE_POKER_DATA_DIR:?fresh task data required}\"",
      "capture": "See DESIGN.md M4: owned tmux socket/session/pane required; wrapper not implemented",
      "sizes": [
        "80x24",
        "120x40"
      ]
    }
  ]
}
