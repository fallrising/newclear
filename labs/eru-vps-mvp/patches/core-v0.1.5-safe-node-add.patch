diff --git a/store/common/node_test.go b/store/common/node_test.go
index 8277e46..1c7df9b 100644
--- a/store/common/node_test.go
+++ b/store/common/node_test.go
@@ -4,0 +5,2 @@ import (
+	"encoding/json"
+	"fmt"
@@ -59,0 +62,32 @@ func (k *brokenWatchKV) NotFound(error) bool { return false }
+
+type addNodeCaptureKV struct {
+	KV
+	created map[string]string
+}
+
+func (k *addNodeCaptureKV) GetOne(_ context.Context, key string) (string, error) {
+	if key != fmt.Sprintf(PodInfoKey, "eru") {
+		return "", fmt.Errorf("unexpected key %s", key)
+	}
+	return `{"name":"eru"}`, nil
+}
+
+func (k *addNodeCaptureKV) Create(_ context.Context, data map[string]string) error {
+	k.created = data
+	return nil
+}
+
+func TestAddNodeStartsBypassed(t *testing.T) {
+	kv := &addNodeCaptureKV{}
+	store := New(kv, types.Config{}, nil)
+	node, err := store.AddNode(t.Context(), &types.AddNodeOptions{
+		Nodename: "worker-4", Endpoint: "containerd://ckc@100.64.0.44:22", Podname: "eru",
+	})
+	require.NoError(t, err)
+	assert.True(t, node.Bypass)
+
+	var persisted types.Node
+	require.NoError(t, json.Unmarshal([]byte(kv.created[fmt.Sprintf(NodeInfoKey, "worker-4")]), &persisted))
+	assert.True(t, persisted.Bypass)
+	assert.Equal(t, "containerd://ckc@100.64.0.44:22", persisted.Endpoint)
+}
