--- /dev/null
+++ b/compat/v015/compat_test.go
@@ -0,0 +1,286 @@
+// Package v015_test exercises the v0.1.5 persisted metadata/wire contract on
+// the candidate core. Fixtures use the JSON tags and resource shapes reviewed
+// at v0.1.5 e19ceb7e09d95bedea3eb0c25bec9308101fecc5. They are synthetic,
+// contain no live identities, and deliberately do not claim plugin or VPS E2E.
+package v015_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"iter"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/projecteru2/core/cluster"
+	"github.com/projecteru2/core/rpc"
+	pb "github.com/projecteru2/core/rpc/gen"
+	"github.com/projecteru2/core/store/common"
+	"github.com/projecteru2/core/types"
+	"github.com/projecteru2/core/utils"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+type legacy struct {
+	Workload     types.Workload         `json:"workload"`
+	Node         types.Node             `json:"node"`
+	ResourceInfo types.NodeResourceInfo `json:"resource_info"`
+	Status       types.StatusMeta       `json:"status"`
+}
+
+func fixture(t *testing.T) legacy {
+	t.Helper()
+	raw, err := os.ReadFile("testdata/legacy.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var f legacy
+	if err := json.Unmarshal(raw, &f); err != nil {
+		t.Fatal(err)
+	}
+	return f
+}
+func jsonEqual(t *testing.T, expected, actual any) {
+	t.Helper()
+	decode := func(v any) any {
+		raw, err := json.Marshal(v)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var out any
+		if err := json.Unmarshal(raw, &out); err != nil {
+			t.Fatal(err)
+		}
+		return out
+	}
+	if !reflect.DeepEqual(decode(expected), decode(actual)) {
+		t.Fatalf("JSON changed: want %#v, got %#v", expected, actual)
+	}
+}
+
+// Embedding the interface makes an unexpected storage operation fail immediately.
+// The implemented methods model only storage; all core transformations are real.
+var fixtureNotFound = errors.New("fixture key absent")
+
+type fixtureKV struct {
+	common.KV
+	data    map[string]string
+	failure error
+	deleted []string
+}
+
+func (k *fixtureKV) GetMulti(_ context.Context, keys []string) (map[string]string, error) {
+	if k.failure != nil {
+		return nil, k.failure
+	}
+	out := map[string]string{}
+	for _, key := range keys {
+		value, ok := k.data[key]
+		if !ok {
+			return nil, fmt.Errorf("%s: %w", key, fixtureNotFound)
+		}
+		out[key] = value
+	}
+	return out, nil
+}
+func (k *fixtureKV) GetOne(ctx context.Context, key string) (string, error) {
+	rows, err := k.GetMulti(ctx, []string{key})
+	return rows[key], err
+}
+func (k *fixtureKV) GetPrefix(_ context.Context, prefix string, _ int64) (map[string]string, error) {
+	out := map[string]string{}
+	for key, value := range k.data {
+		if strings.HasPrefix(key, prefix) {
+			out[key] = value
+		}
+	}
+	return out, nil
+}
+func (*fixtureKV) NotFound(err error) bool { return errors.Is(err, fixtureNotFound) }
+func (k *fixtureKV) Update(_ context.Context, data map[string]string) error {
+	for key, value := range data {
+		k.data[key] = value
+	}
+	return nil
+}
+func (k *fixtureKV) Delete(_ context.Context, keys []string) error {
+	k.deleted = append([]string{}, keys...)
+	for _, key := range keys {
+		delete(k.data, key)
+	}
+	return nil
+}
+func (*fixtureKV) Watch(_ context.Context, prefix string) iter.Seq[common.Event] {
+	return func(yield func(common.Event) bool) {
+		yield(common.Event{Key: prefix + "legacy-exact-id", Type: common.EventPut})
+	}
+}
+func TestLegacyMetadataUpdateAndExactCleanup(t *testing.T) {
+	f := fixture(t)
+	kv := &fixtureKV{data: map[string]string{"/unrelated/peer": "preserve", "/resource/worker-4": "quota-preserved"}}
+	s := fixtureStore(t, kv)
+	if err := s.UpdateWorkload(t.Context(), &f.Workload); err != nil {
+		t.Fatal(err)
+	}
+	keys := []string{"/workloads/legacy-exact-id", "/node/worker-4:workloads/legacy-exact-id", "/deploy/hello/web/worker-4/legacy-exact-id"}
+	if len(kv.data) != 5 {
+		t.Fatalf("unexpected metadata writes: %v", kv.data)
+	}
+	for _, key := range keys {
+		var row types.Workload
+		if err := json.Unmarshal([]byte(kv.data[key]), &row); err != nil {
+			t.Fatal(err)
+		}
+		jsonEqual(t, f.Workload, row)
+	}
+	statusKey := "/status/hello/web/worker-4/legacy-exact-id"
+	kv.data[statusKey] = "status"
+	if err := s.RemoveWorkload(t.Context(), &f.Workload); err != nil {
+		t.Fatal(err)
+	}
+	want := []string{statusKey, keys[2], keys[0], keys[1]}
+	if !reflect.DeepEqual(kv.deleted, want) {
+		t.Fatalf("cleanup scope changed: %v", kv.deleted)
+	}
+	if !reflect.DeepEqual(kv.data, map[string]string{"/unrelated/peer": "preserve", "/resource/worker-4": "quota-preserved"}) {
+		t.Fatalf("cleanup changed unrelated metadata: %v", kv.data)
+	}
+}
+func TestLegacyStatusBindingDoesNotBorrowSiblingStatus(t *testing.T) {
+	for _, present := range []bool{true, false} {
+		t.Run(fmt.Sprint(present), func(t *testing.T) {
+			f := fixture(t)
+			raw, _ := json.Marshal(f.Workload)
+			state, _ := json.Marshal(f.Status)
+			kv := &fixtureKV{data: map[string]string{"/workloads/legacy-exact-id": string(raw), "/status/hello/web/worker-40/legacy-exact-id": string(state)}}
+			if present {
+				kv.data["/status/hello/web/worker-4/legacy-exact-id"] = string(state)
+			}
+			s := fixtureStore(t, kv)
+			ch := s.WorkloadStatusStream(t.Context(), "hello", "web", "worker-4", map[string]string{"owner": "eru-vps-mvp"})
+			select {
+			case msg := <-ch:
+				if msg == nil || msg.Error != nil || msg.Workload == nil {
+					t.Fatalf("legacy metadata unreadable: %#v", msg)
+				}
+				jsonEqual(t, f.Workload, *msg.Workload)
+				if present {
+					if msg.Workload.StatusMeta == nil || !msg.Workload.StatusMeta.Running || !msg.Workload.StatusMeta.Healthy {
+						t.Fatal("legacy status lost")
+					}
+				} else if msg.Workload.StatusMeta != nil {
+					t.Fatal("sibling status incorrectly marks workload healthy")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("status read timed out")
+			}
+			select {
+			case _, ok := <-ch:
+				if ok {
+					t.Fatal("unexpected extra event")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("status stream did not finish")
+			}
+		})
+	}
+}
+
+type fixtureCluster struct {
+	cluster.Cluster
+	workload *types.Workload
+	node     *types.Node
+	store    *common.Store
+}
+
+func (c *fixtureCluster) GetWorkload(ctx context.Context, id string) (*types.Workload, error) {
+	if c.store != nil {
+		return c.store.GetWorkload(ctx, id)
+	}
+	if id != c.workload.ID {
+		return nil, types.ErrWorkloadNotExists
+	}
+	return c.workload, nil
+}
+func (c *fixtureCluster) GetNode(_ context.Context, name string) (*types.Node, error) {
+	if name != c.node.Name {
+		return nil, types.ErrInvaildNodeFilter
+	}
+	return c.node, nil
+}
+func TestLegacyRPCIdentityAndResourceFields(t *testing.T) {
+	f := fixture(t)
+	f.Workload.StatusMeta = &f.Status
+	f.Node.ResourceInfo = f.ResourceInfo
+	server := rpc.New(&fixtureCluster{workload: &f.Workload, node: &f.Node}, types.Config{}, make(chan struct{}))
+	w, err := server.GetWorkload(t.Context(), &pb.WorkloadID{Id: f.Workload.ID})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if w.Id != f.Workload.ID || w.Name != f.Workload.Name || w.Nodename != f.Workload.Nodename || w.Podname != f.Workload.Podname || w.Image != f.Workload.Image || w.CreateTime != f.Workload.CreateTime {
+		t.Fatalf("legacy workload identity changed: %v", w)
+	}
+	if !reflect.DeepEqual(w.Labels, f.Workload.Labels) || !reflect.DeepEqual(w.Env, f.Workload.Env) || !w.Status.Running || !w.Status.Healthy {
+		t.Fatal("legacy ownership or readiness lost")
+	}
+	var resources map[string]any
+	if err := json.Unmarshal([]byte(w.Resources), &resources); err != nil {
+		t.Fatal(err)
+	}
+	jsonEqual(t, f.Workload.Resources, resources)
+	n, err := server.GetNode(t.Context(), &pb.GetNodeOptions{Nodename: f.Node.Name})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n.Name != f.Node.Name || n.Endpoint != f.Node.Endpoint || n.Podname != f.Node.Podname || !n.Bypass || !reflect.DeepEqual(n.Labels, f.Node.Labels) {
+		t.Fatalf("legacy fenced node identity changed: %v", n)
+	}
+	for _, pair := range []struct {
+		wire string
+		want any
+	}{{n.ResourceCapacity, f.ResourceInfo.Capacity}, {n.ResourceUsage, f.ResourceInfo.Usage}} {
+		var decoded any
+		if err := json.Unmarshal([]byte(pair.wire), &decoded); err != nil {
+			t.Fatal(err)
+		}
+		jsonEqual(t, pair.want, decoded)
+	}
+}
+func TestMissingWorkloadMigrationKeepsBackendFailuresDistinct(t *testing.T) {
+	// v0.1.5 returned custom code 1051 for missing metadata. v0.1.7 must
+	// expose standard NotFound; ambiguous counts and transport errors stay errors.
+	for _, tc := range []struct {
+		name    string
+		failure error
+		want    codes.Code
+	}{{"absent", nil, codes.NotFound}, {"ambiguous", types.ErrInvaildCount, rpc.GetWorkload}, {"transport", errors.New("backend unavailable"), rpc.GetWorkload}} {
+		t.Run(tc.name, func(t *testing.T) {
+			kv := &fixtureKV{data: map[string]string{}, failure: tc.failure}
+			s := fixtureStore(t, kv)
+			_, storeErr := s.GetWorkload(t.Context(), "legacy-exact-id")
+			if (tc.failure == nil) != errors.Is(storeErr, types.ErrWorkloadNotExists) {
+				t.Fatalf("missing workload classification changed: %v", storeErr)
+			}
+			server := rpc.New(&fixtureCluster{store: s}, types.Config{}, make(chan struct{}))
+			row, err := server.GetWorkload(t.Context(), &pb.WorkloadID{Id: "legacy-exact-id"})
+			if row != nil || status.Code(err) != tc.want {
+				t.Fatalf("want %v, got %v / %v", tc.want, row, err)
+			}
+		})
+	}
+}
+
+func fixtureStore(t *testing.T, kv *fixtureKV) *common.Store {
+	t.Helper()
+	pool, err := utils.NewPool(2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(pool.Release)
+	return common.New(kv, types.Config{}, pool)
+}
