new file mode 100644
--- /dev/null
+++ b/store/etcdv3/meta/compat_v015_test.go
@@ -0,0 +1,66 @@
+package meta
+
+import (
+	"github.com/projecteru2/core/store/etcdv3/meta/mocks"
+	"github.com/projecteru2/core/types"
+	"github.com/stretchr/testify/mock"
+	"github.com/stretchr/testify/require"
+	"go.etcd.io/etcd/api/v3/etcdserverpb"
+	"go.etcd.io/etcd/api/v3/mvccpb"
+	clientv3 "go.etcd.io/etcd/client/v3"
+	"testing"
+)
+
+// v0.1.5 classified a zero-row exact read as ErrInvaildCount. The v0.1.7
+// migration distinguishes absence from corrupt/ambiguous cardinality. Inject
+// client responses directly: this test starts no etcd service or network.
+func TestV015MissingKeyMigration(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		count int64
+		want  error
+	}{{"missing", 0, types.ErrKeyNotFound}, {"ambiguous", 2, types.ErrInvaildCount}} {
+		t.Run(tc.name, func(t *testing.T) {
+			client := &mocks.ETCDClientV3{}
+			e := &ETCD{cliv3: client}
+			client.On("Get", mock.Anything, "/workloads/legacy-id").Return(&clientv3.GetResponse{Count: tc.count}, nil).Once()
+			row, err := e.GetOne(t.Context(), "/workloads/legacy-id")
+			require.Nil(t, row)
+			require.ErrorIs(t, err, tc.want)
+			if tc.count == 0 {
+				require.NotErrorIs(t, err, types.ErrInvaildCount)
+			} else {
+				require.NotErrorIs(t, err, types.ErrKeyNotFound)
+			}
+			client.AssertExpectations(t)
+		})
+	}
+}
