# Copy to .env, chmod 600, replace both password placeholders with one random value.
# Use URL-safe characters for this development database password.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://agent_platform:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@127.0.0.1:55432/agent_platform
APP_ORIGIN=http://127.0.0.1:5173
APP_INSECURE_LOCAL=1

# M2 worker only: leave blank for fake-only operation; register with the local CLI.
CONNECTOR_ORIGIN=
CONNECTOR_TOKEN_FILE=

# AT-11-B opt-in for all real workers after drain/migration 009.
# Private fixture config path; never put its credential in this file or argv.
# Blank retains the explicit legacy guest-local fixture for NEW runs.
MODEL_PROXY_CONFIG=
