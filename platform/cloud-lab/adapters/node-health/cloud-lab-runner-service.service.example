# Replace paths with privately reviewed absolute paths before installation.
# Policy contains fixed service/Access deadlines bound to the complete config.
[Unit]
Description=Cloud Lab authorized node-health service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 /ABSOLUTE/runner.py --config /ABSOLUTE/runner.json --service-policy /ABSOLUTE/service-policy.json --poll-seconds 30
Restart=on-abnormal
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
