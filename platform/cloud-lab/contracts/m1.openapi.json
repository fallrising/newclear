            "description": "Invalid schema or deadline"
          },
          "429": {
            "description": "Single active slot or storage/admission quota"
          },
          "503": {
            "description": "Unavailable; retry same immutable command"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          }
        ]
      }
    },
    "/api/runner/claim": {
      "post": {
        "summary": "Claim dispatch or reconcile-only snapshot coordination lease",
        "responses": {
          "200": {
            "description": "Authorized durable response; request_id included except artifact bytes."
          },
          "401": {
            "description": "Invalid or replayed credential"
          },
          "403": {
            "description": "Scope, revoked grant, or Origin denied"
          },
          "409": {
            "description": "Idempotency, revision, fence or result conflict"
          },
          "413": {
            "description": "Bounded request/output exceeded"
          },
          "422": {
            "description": "Invalid schema or deadline"
          },
          "429": {
            "description": "Single active slot or storage/admission quota"
          },
          "503": {
            "description": "Unavailable; retry same immutable command"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
