          },
          "422": {
            "description": "Invalid schema or deadline"
          },
          "429": {
            "description": "Single active slot or storage/admission quota"
          },
          "503": {
            "description": "Unavailable; retry same immutable command"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          }
        ]
      }
    },
    "/api/commands/{id}/artifact": {
