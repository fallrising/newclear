{
  "openapi": "3.1.0",
  "info": {
    "title": "Cloud Lab M1 local implementation profile",
    "version": "0.1.0",
    "description": "Not deployed. Exact protocol/limits and narrowed M0 semantics in docs/m1-implementation.md. No arbitrary shell, generic callback events or admin APIs. Unknown fields/duplicate JSON keys/floats/non-UTF8 rejected. HMAC message includes audience,key ID,generation,method,path,time,nonce,raw-body SHA256; see profile."
  },
  "security": [
    {
      "AccessJWT": []
    },
    {
      "MachineHMAC": []
    }
  ],
  "paths": {
    "/api/bootstrap": {
      "get": {
        "summary": "Scope, recipe, capabilities and server time",
        "responses": {
          "200": {
            "description": "Authorized durable response; request_id included except artifact bytes."
          },
          "401": {
            "description": "Invalid or replayed credential"
          },
          "403": {
            "description": "Scope, revoked grant, or Origin denied"
          },
          "409": {
            "description": "Idempotency, revision, fence or result conflict"
          },
          "413": {
            "description": "Bounded request/output exceeded"
          },
          "422": {
            "description": "Invalid schema or deadline"
          },
          "429": {
            "description": "Single active slot or storage/admission quota"
          },
          "503": {
            "description": "Unavailable; retry same immutable command"
          }
        }
      }
    },
    "/api/commands": {
      "get": {
        "summary": "At most20 recent authorized records within32KiB",
        "responses": {
          "200": {
            "description": "Authorized durable response; request_id included except artifact bytes."
          },
          "401": {
            "description": "Invalid or replayed credential"
          },
          "403": {
            "description": "Scope, revoked grant, or Origin denied"
          },
          "409": {
            "description": "Idempotency, revision, fence or result conflict"
          },
          "413": {
            "description": "Bounded request/output exceeded"
          },
          "422": {
            "description": "Invalid schema or deadline"
          },
          "429": {
            "description": "Single active slot or storage/admission quota"
          },
          "503": {
            "description": "Unavailable; retry same immutable command"
          }
        }
      },
      "post": {
        "summary": "Admit byte-idempotent command",
        "responses": {
          "200": {
            "description": "Authorized durable response; request_id included except artifact bytes."
          },
          "401": {
            "description": "Invalid or replayed credential"
          },
          "403": {
            "description": "Scope, revoked grant, or Origin denied"
          },
          "409": {
            "description": "Idempotency, revision, fence or result conflict"
          },
          "413": {
            "description": "Bounded request/output exceeded"
          },
          "422": {
            "description": "Invalid schema or deadline"
          },
          "429": {
            "description": "Single active slot or storage/admission quota"
          },
          "503": {
            "description": "Unavailable; retry same immutable command"
          },
          "202": {
            "description": "Durably accepted or existing byte-identical command, not execution success"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        }
      }
    },
    "/api/commands/{id}": {
      "get": {
        "summary": "Read authorized command",
        "responses": {
          "200": {
            "description": "Authorized durable response; request_id included except artifact bytes."
          },
          "401": {
            "description": "Invalid or replayed credential"
          },
          "403": {
            "description": "Scope, revoked grant, or Origin denied"
          },
          "409": {
            "description": "Idempotency, revision, fence or result conflict"
          },
          "413": {
            "description": "Bounded request/output exceeded"
          },
          "422": {
            "description": "Invalid schema or deadline"
          },
          "429": {
            "description": "Single active slot or storage/admission quota"
          },
          "503": {
            "description": "Unavailable; retry same immutable command"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            }
          }
        ]
      }
    },
    "/api/commands/{id}/cancel": {
