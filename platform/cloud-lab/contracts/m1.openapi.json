    "/api/runner/report": {
      "post": {
        "summary": "Report current fenced authoritative journal snapshot",
        "responses": {
          "200": {
            "description": "Authorized durable response; request_id included except artifact bytes."
          },
          "401": {
            "description": "Invalid or replayed credential"
          },
          "403": {
            "description": "Scope, revoked grant, or Origin denied"
          },
          "409": {
            "description": "Idempotency, revision, fence or result conflict"
          },
          "413": {
            "description": "Bounded request/output exceeded"
          },
          "422": {
            "description": "Invalid schema or deadline"
          },
          "429": {
            "description": "Single active slot or storage/admission quota"
          },
          "503": {
            "description": "Unavailable; retry same immutable command"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Report"
              }
            }
          }
        }
      }
    },
    "/api/authorization/self": {
      "post": {
        "summary": "Read only the authenticated machine credential and grant metadata",
        "description": "Normal HMAC, expiry, grant and nonce checks apply. No command/grant changes; anti-replay nonce storage still mutates. Human JWTs denied. This source change is not a live deployment claim.",
        "security": [
          {
            "MachineHMAC": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Own metadata from the current Worker authentication context; Cache-Control:no-store. No Access token or resident-process evidence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelfAuthorization"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, revoked or replayed machine credential"
          },
          "403": {
            "description": "Human identity, expired/revoked grant or scope denied"
          },
          "422": {
            "description": "Nonempty or invalid request"
          },
          "503": {
            "description": "Configuration or storage unavailable"
          }
        }
      }
    },
    "/api/health-schedule": {
      "get": {
        "summary": "Scoped read-only bounded health schedule status, latest firing and completed observation; not Cron/liveness verification",
        "responses": {
          "200": {
            "description": "cloudlab.health-schedule.v1; request_id and UTC now; cron_verified=false; schedule=null or bounded scoped snapshot. See docs/health-schedule.md.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSchedule"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or replayed credential"
          },
          "403": {
            "description": "Scope, revoked grant, or Origin denied"
          },
          "409": {
            "description": "Idempotency, revision, fence or result conflict"
          },
          "413": {
            "description": "Bounded request/output exceeded"
          },
          "422": {
            "description": "Invalid schema or deadline"
          },
          "429": {
            "description": "Single active slot or storage/admission quota"
          },
          "503": {
            "description": "Unavailable; retry same immutable command"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AccessJWT": {
        "type": "apiKey",
        "in": "header",
        "name": "Cf-Access-Jwt-Assertion",
        "description": "Cloudflare Access validated JWT, subject mapped server-side; browser writes additionally require same Origin and X-Cloud-Lab:1."
      },
      "MachineHMAC": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Lab-Signature",
        "description": "HMAC-SHA256 with X-Lab-Key-Id, X-Lab-Time, X-Lab-Nonce. Separate outer Access service credentials if required."
      }
    },
    "schemas": {
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "schema_minor",
          "workspace_id",
          "resource_ref",
          "recipe_ref",
          "parameters",
          "idempotency_key",
          "not_before",
          "dispatch_deadline",
          "execution_deadline",
          "timeout_seconds",
          "output_budget_bytes"
        ],
        "properties": {
          "schema_version": {
            "const": "cloudlab.command.v1"
          },
          "schema_minor": {
            "const": 0
          },
          "workspace_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "resource_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_id",
              "generation"
            ],
            "properties": {
              "resource_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "generation": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            }
          },
          "recipe_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recipe_id",
              "version",
              "digest"
            ],
            "properties": {
              "recipe_id": {
                "const": "node-health"
              },
              "version": {
                "const": "1.0.0"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "parameters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_sample_age_seconds"
            ],
            "properties": {
              "max_sample_age_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            }
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "not_before": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "dispatch_deadline": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "execution_deadline": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "timeout_seconds": {
            "const": 10
          },
          "output_budget_bytes": {
            "const": 16384
          }
        }
      },
      "Report": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "attempt_id",
          "fence",
          "owner_outcome",
          "started_at",
          "finished_at",
          "artifact"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "fence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "owner_outcome": {
            "enum": [
              "succeeded",
              "unknown"
            ]
          },
          "started_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "artifact": {
            "type": [
              "string",
              "null"
            ],
            "description": "Exact UTF-8 health JSON bytes encoded as a string; <=16384 bytes. Unknown requires null for all evidence fields."
          }
        }
      },
      "HealthArtifact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "sample_age_seconds",
          "checks",
          "metrics"
        ],
        "properties": {
          "status": {
            "enum": [
              "healthy",
              "unhealthy"
            ]
          },
          "sample_age_seconds": {
            "const": 0
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "collector"
            ],
            "properties": {
              "collector": {
                "const": "ok"
              }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "load_1m_milli",
              "cpu_count",
              "disk_free_percent"
            ],
            "properties": {
              "load_1m_milli": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "cpu_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              },
              "disk_free_percent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      },
      "SelfAuthorization": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "observed_at",
          "request_id",
          "credential",
          "grant",
          "scope"
        ],
        "properties": {
          "schema_version": {
            "const": "cloudlab.authorization-self.v1"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "credential": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "generation",
              "principal_id",
              "grant_id",
              "revoked",
              "expires_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "generation": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "principal_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "grant_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "revoked": {
                "const": false
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            }
          },
          "grant": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision",
              "principal_id",
              "not_before",
              "expires_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "principal_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "not_before": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              }
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspace_id",
              "resource_ref",
              "recipe_ref"
            ],
            "properties": {
              "workspace_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "resource_ref": {
                "$ref": "#/components/schemas/Command/properties/resource_ref"
              },
              "recipe_ref": {
                "$ref": "#/components/schemas/Command/properties/recipe_ref"
              }
            }
          }
        }
      },
      "HealthSchedule": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "now",
          "cron_verified",
          "schedule"
        ],
        "properties": {
          "schema_version": {
            "const": "cloudlab.health-schedule.v1"
          },
          "request_id": {
            "type": "string"
          },
          "now": {
            "type": "string",
            "format": "date-time"
          },
          "cron_verified": {
            "const": false
          },
          "schedule": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "revision",
                  "enabled",
                  "status",
                  "interval_minutes",
                  "not_before",
                  "expires_at",
                  "next_due_at",
                  "last_firing",
                  "latest_result"
                ],
                "properties": {
                  "id": {
                    "const": "health-minute"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "status": {
                    "enum": [
                      "disabled",
                      "unconfigured",
                      "invalid_policy",
                      "waiting",
                      "expired",
                      "ready",
                      "grant_unavailable",
                      "window_exhausted"
                    ]
                  },
                  "interval_minutes": {
                    "enum": [
                      null,
                      15,
                      60,
                      1440
                    ]
                  },
                  "not_before": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "expires_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "next_due_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "last_firing": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "due_at UTC, outcome submitted or skipped reason, command_id string or null; linkage comes from persisted firings."
                  },
                  "latest_result": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Latest in-scope scheduled public command record with result, across revisions; no artifact bytes/report_digest/holder. At most20 candidates scanned."
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
