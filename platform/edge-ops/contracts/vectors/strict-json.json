{
  "description": "Strict JSON profile (contracts/README.md#strict-json). `input` is UTF-8 encoded before parsing; `input_hex` gives raw bytes. max_bytes is 64 unless stated.",
  "max_bytes": 64,
  "cases": [
    { "name": "object", "input": "{\"a\":1,\"b\":[true,false,null],\"c\":\"x\"}", "expect": { "ok": true } },
    { "name": "whitespace_allowed", "input": " \t\r\n{ \"a\" : 1 }\n", "expect": { "ok": true } },
    { "name": "max_safe_integer", "input": "9007199254740991", "expect": { "ok": true } },
    { "name": "min_safe_integer", "input": "-9007199254740991", "expect": { "ok": true } },
    { "name": "surrogate_pair_escape", "input": "\"\\ud83d\\ude00\"", "expect": { "ok": true } },
    { "name": "raw_utf8_non_ascii", "input": "\"節點\"", "expect": { "ok": true } },
    { "name": "empty_key_allowed", "input": "{\"\":1}", "expect": { "ok": true } },
    { "name": "empty", "input": "", "expect": { "ok": false, "code": "syntax" } },
    { "name": "too_large", "input": "\"0123456789012345678901234567890123456789012345678901234567890123\"", "expect": { "ok": false, "code": "too_large" } },
    { "name": "invalid_utf8", "input_hex": "22ff22", "expect": { "ok": false, "code": "invalid_utf8" } },
    { "name": "utf8_encoded_surrogate", "input_hex": "22eda08022", "expect": { "ok": false, "code": "invalid_utf8" } },
    { "name": "overlong_utf8", "input_hex": "22c0af22", "expect": { "ok": false, "code": "invalid_utf8" } },
    { "name": "bom", "input_hex": "efbbbf7b7d", "expect": { "ok": false, "code": "bom" } },
    { "name": "duplicate_key", "input": "{\"a\":1,\"a\":2}", "expect": { "ok": false, "code": "duplicate_key" } },
    { "name": "duplicate_key_after_unescape", "input": "{\"a\":1,\"\\u0061\":2}", "expect": { "ok": false, "code": "duplicate_key" } },
    { "name": "duplicate_key_nested", "input": "{\"x\":{\"k\":1,\"k\":1}}", "expect": { "ok": false, "code": "duplicate_key" } },
    { "name": "float", "input": "1.5", "expect": { "ok": false, "code": "non_integer_number" } },
    { "name": "float_zero_fraction", "input": "1.0", "expect": { "ok": false, "code": "non_integer_number" } },
    { "name": "exponent", "input": "1e3", "expect": { "ok": false, "code": "non_integer_number" } },
    { "name": "negative_zero", "input": "-0", "expect": { "ok": false, "code": "non_canonical_number" } },
    { "name": "above_safe_integer", "input": "9007199254740992", "expect": { "ok": false, "code": "integer_out_of_range" } },
    { "name": "huge_integer", "input": "123456789012345678901234567890", "expect": { "ok": false, "code": "integer_out_of_range" } },
    { "name": "leading_zero", "input": "01", "expect": { "ok": false, "code": "syntax" } },
    { "name": "plus_sign", "input": "+1", "expect": { "ok": false, "code": "syntax" } },
    { "name": "nan_literal", "input": "NaN", "expect": { "ok": false, "code": "syntax" } },
    { "name": "infinity_literal", "input": "-Infinity", "expect": { "ok": false, "code": "syntax" } },
    { "name": "lone_high_surrogate", "input": "\"\\ud800\"", "expect": { "ok": false, "code": "lone_surrogate" } },
    { "name": "lone_low_surrogate", "input": "\"\\udc00\"", "expect": { "ok": false, "code": "lone_surrogate" } },
    { "name": "reversed_surrogates", "input": "\"\\ude00\\ud83d\"", "expect": { "ok": false, "code": "lone_surrogate" } },
    { "name": "raw_control_char", "input_hex": "220a22", "expect": { "ok": false, "code": "syntax" } },
    { "name": "invalid_escape", "input": "\"\\x41\"", "expect": { "ok": false, "code": "syntax" } },
    { "name": "single_quotes", "input": "{'a':1}", "expect": { "ok": false, "code": "syntax" } },
    { "name": "trailing_comma", "input": "[1,2,]", "expect": { "ok": false, "code": "syntax" } },
    { "name": "comment", "input": "{\"a\":1 /* c */}", "expect": { "ok": false, "code": "syntax" } },
    { "name": "trailing_data", "input": "{} {}", "expect": { "ok": false, "code": "trailing_data" } },
    { "name": "trailing_nul", "input_hex": "7b7d00", "expect": { "ok": false, "code": "trailing_data" } },
    { "name": "depth_32_ok", "input": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]", "expect": { "ok": true } },
    { "name": "depth_33_rejected", "input": "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]", "max_bytes": 128, "expect": { "ok": false, "code": "depth" } }
  ]
}
