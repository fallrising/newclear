{
  "project": "ice-maker",
  "verified": false,
  "verifiedNote": "由原始碼推斷，尚未實際啟動；第一次執行時驗證並修正後改為 true。",
  "locale": "zh-TW",
  "colorSchemes": [
    "light",
    "dark"
  ],
  "apps": [
    {
      "name": "document-service",
      "kind": "server",
      "cwd": "platform/ice-maker",
      "install": "pip install -e '.[<document-service extras>]'",
      "start": "document-service --state-root fe-review/runs/.state --config config/document-ingestion.json --host 127.0.0.1 --port 8765 --pdfinfo \"$(command -v pdfinfo)\"",
      "env": {},
      "baseUrl": "http://127.0.0.1:8765",
      "ready": "/healthz",
      "pages": [
        {
          "id": "upload",
          "path": "/"
        }
      ]
    }
  ]
}
