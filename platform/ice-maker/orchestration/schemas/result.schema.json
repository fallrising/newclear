{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ice-maker.local/schemas/result.schema.json",
  "title": "Bounded agent result evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "base_sha", "status", "summary", "changed_files", "commands_run", "acceptance", "tests", "risks", "open_questions", "usage"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "base_sha": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "status": {"type": "string", "enum": ["completed", "failed", "blocked"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 10000},
    "changed_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "commands_run": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["command", "exit_code", "output"], "properties": {"command": {"type": "string", "minLength": 1, "maxLength": 2000}, "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}, "output": {"type": "string", "minLength": 1, "maxLength": 20000}}}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["criterion", "status", "evidence"], "properties": {"criterion": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["pass", "fail", "not-tested"]}, "evidence": {"type": "string", "minLength": 1}}}},
    "tests": {"type": "object", "additionalProperties": false, "required": ["passed", "failed"], "properties": {"passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "estimated_cost_usd", "elapsed_seconds"], "properties": {"provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "estimated_cost_usd": {"type": "number", "minimum": 0, "maximum": 10000}, "elapsed_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}}}
  },
  "$defs": {"path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.?\\.?(/|$))(?!.*(?:^|/)\\.git(?:/|$))[A-Za-z0-9._/@#-]+$"}}
}
