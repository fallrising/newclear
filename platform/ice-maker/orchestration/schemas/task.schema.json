{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ice-maker.local/schemas/task.schema.json",
  "title": "Unified bounded agent task contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "repo", "base_sha", "spec_path", "task_path", "role", "allowed_paths", "network_policy", "max_seconds", "max_cost_usd", "required_commands"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_sha": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "spec_path": {"$ref": "#/$defs/relativePath"},
    "task_path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.?\\.?(/|$))(?!.*(?:^|/)\\.git(?:/|$))[A-Za-z0-9._/@#-]+$"},
    "role": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relativePathPattern"}},
    "network_policy": {"type": "string", "enum": ["deny-by-default", "allowlisted"]},
    "max_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 10000},
    "required_commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.?\\.?(/|$))(?!.*(?:^|/)\\.git(?:/|$))[A-Za-z0-9._/@#-]+$"},
    "relativePathPattern": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.?\\.?(/|$))(?!.*(?:^|/)\\.git(?:/|$))[A-Za-z0-9._/@#*?{}-]+$"}
  }
}
