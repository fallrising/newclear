# Generate a long random value. This deliberately invalid value prevents accidental use.
OCR_API_KEY=change-me

# Engine ports bind to loopback so an operator-owned TLS proxy can publish them.
OCR_BIND_IP=127.0.0.1
RAPIDOCR_PORT=8011
TESSERACT_PORT=8012
PADDLE_STRUCTURE_PORT=8013

OCR_MAX_UPLOAD_BYTES=10485760
OCR_MAX_IMAGE_PIXELS=25000000
OCR_MAX_IMAGE_DIMENSION=16384
OCR_MAX_CONCURRENCY=1
OCR_MAX_QUEUE_SIZE=1
OCR_QUEUE_TIMEOUT_SECONDS=5
OCR_ENGINE_THREADS=2
OCR_TESSERACT_LANGUAGES=chi_tra+eng
