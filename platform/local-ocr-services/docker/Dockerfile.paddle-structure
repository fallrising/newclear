FROM python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONPATH=/app/src \
    OCR_BACKEND=paddle-structure \
    OCR_MODEL_CACHE_DIR=/opt/ocr-models \
    PADDLE_PDX_CACHE_HOME=/opt/ocr-models \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=1 \
    OCR_ARTIFACT_MANIFEST=/opt/ocr-artifacts.sha256

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 ocr \
    && useradd --system --uid 10001 --gid ocr --home-dir /nonexistent ocr \
    && mkdir -p /opt/ocr-models

COPY requirements/base.txt requirements/paddle-structure.txt /app/requirements/
RUN python -m pip install --disable-pip-version-check --no-cache-dir \
    -r /app/requirements/paddle-structure.txt

COPY src /app/src
COPY docker/entrypoint.sh /usr/local/bin/ocr-entrypoint

RUN OCR_API_KEY=build-only-api-key OCR_ALLOW_MODEL_DOWNLOAD=1 \
        python -m ocr_service.warmup \
    && find /opt/ocr-models -type f -exec sha256sum {} + \
        > /opt/ocr-artifacts.sha256 \
    && test -s /opt/ocr-artifacts.sha256 \
    && chmod 0555 /usr/local/bin/ocr-entrypoint \
    && chmod -R a-w /opt/ocr-models \
    && chown -R ocr:ocr /app

ENV OCR_ALLOW_MODEL_DOWNLOAD=0 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

USER 10001:10001
EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/ocr-entrypoint"]
CMD ["python", "-m", "uvicorn", "ocr_service.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
