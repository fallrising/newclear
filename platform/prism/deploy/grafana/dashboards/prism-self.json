{
  "uid": "prism-self",
  "title": "Prism: ingestion and query",
  "description": "Phase 1 metrics are available. Rule evaluation, notification delivery and disk pressure are future-phase capabilities.",
  "tags": [
    "prism"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Ingested metric series",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prism-metrics"
      },
      "description": "Queries stored metric series through the Phase 1 Prometheus API; nonempty after ingestion.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count({__name__=~\".+\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Ingest received rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prism-metrics"
      },
      "description": "Requires an external scraper to remote_write prismd /metrics; self-monitor does not write into storage in Phase 1.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (signal) (rate(prism_ingest_received_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Ingest drops",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prism-metrics"
      },
      "description": "Requires an external /metrics scraper.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (signal,reason) (rate(prism_ingest_dropped_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Query latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prism-metrics"
      },
      "description": "Requires an external /metrics scraper. Rule evaluation, notification queue and disk pressure panels become available in later phases.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prism_query_duration_seconds_bucket[5m])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Query fallback rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prism-metrics"
      },
      "description": "Requires an external /metrics scraper. A nonzero value indicates Phase 1 fallback queries.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prism_query_fallback_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Rule evaluation failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prism-metrics"
      },
      "description": "Future Phase 2: the rule evaluator is inactive.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prism_rule_eval_failures_total[5m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Notification queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prism-metrics"
      },
      "description": "Future Phase 2: notification dispatch is inactive.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prism_notification_queue_depth",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Disk pressure",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prism-metrics"
      },
      "description": "Future phase: disk pressure monitoring is inactive.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prism_disk_pressure_level",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
