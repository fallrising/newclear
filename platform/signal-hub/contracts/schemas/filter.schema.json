{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalhub.example.invalid/contracts/filter.schema.json",
  "type": "object",
  "properties": {
    "types": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+(\\.\\*)?(?![\\s\\S])"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^*]+\\*?(?![\\s\\S])"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "severity_min": {
      "enum": [
        "debug",
        "info",
        "notice",
        "warning",
        "error",
        "critical"
      ]
    },
    "subject_prefix": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+){0,2}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "required": [],
  "additionalProperties": false
}
