{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalhub.example.invalid/contracts/sources.schema.json",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])"
          },
          "source_prefix": {
            "type": "string",
            "format": "uri-reference",
            "minLength": 1
          },
          "allowed_types": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+(\\.\\*)?(?![\\s\\S])"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "expected_interval": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(s|m|h|d)(?![\\s\\S])"
          },
          "retention_days": {
            "type": "integer",
            "minimum": 1
          },
          "token_ref": {
            "type": "string",
            "pattern": "^file:/[^\\s]+(?![\\s\\S])"
          }
        },
        "required": [
          "name",
          "source_prefix",
          "allowed_types",
          "token_ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sources"
  ],
  "additionalProperties": false
}
