            "type": "string",
            "description": "BUILD_REVISION var (git short SHA or \"dev\")."
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          }
        }
      },
      "ValidationIssue": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "issue"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "JSON-path-like, 0-based, e.g. steps[2].instruction.",
            "examples": [
              "title",
              "tags[1]",
              "steps[0].script_revision"
            ]
          },
          "issue": {
            "type": "string",
            "enum": [
              "required",
              "too_short",
              "too_long",
              "invalid_format",
              "invalid_value",
              "duplicate",
              "too_few_items",
              "too_many_items",
              "not_found"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "unauthenticated",
                  "not_found",
                  "revision_not_found",
                  "method_not_allowed",
                  "revision_conflict",
                  "archived",
                  "request_too_large",
                  "script_too_large",
                  "validation_failed",
                  "internal_error"
                ]
              },
              "message": {
                "type": "string",
                "description": "Human-readable; never contains bodies, stack traces or actor emails."
              },
              "current_revision": {
                "type": "integer",
                "minimum": 0,
                "description": "Present only on 409."
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "description": "Present on 413 and 422 (possibly empty); optional otherwise."
              }
            }
          }
        }
      },
