{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kith://contracts/v2/http-error.json",
  "title": "HTTP error envelope v2",
  "description": "Superset of contracts/http-error-v1.json (unchanged). Adds codes introduced by v2 milestones; see docs/v2/milestones/W2.md §4.4 and W4.md §4.4. message is human-readable and must not contain secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "payload_too_large",
            "unauthorized",
            "token_revoked",
            "forbidden",
            "subscription_operator_only",
            "not_found",
            "room_full",
            "generation_dropped",
            "already_member",
            "last_owner",
            "handle_taken",
            "wake_budget_exhausted",
            "not_ready",
            "room_archived",
            "wrong_password",
            "in_use",
            "name_taken",
            "provider_disabled",
            "secrets_key_missing",
            "secret_unavailable"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
