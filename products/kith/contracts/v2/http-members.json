{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kith://contracts/v2/http-members.json",
  "title": "Member directory v2 (B-04)",
  "description": "Operator-only member directory and human account management. No response ever contains a password or hash. Defined in docs/v2/milestones/W2.md §4.2.5.",
  "$defs": {
    "adminMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "handle",
        "display_name",
        "is_operator",
        "quota_class",
        "created_at",
        "disabled_at",
        "must_change_password"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "handle": {
          "type": "string",
          "pattern": "^[a-z0-9_]{2,32}$"
        },
        "display_name": {
          "type": "string"
        },
        "is_operator": {
          "enum": [
            0,
            1
          ]
        },
        "quota_class": {
          "enum": [
            "api_key",
            "operator_personal"
          ]
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "disabled_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "must_change_password": {
          "type": "boolean"
        }
      }
    },
    "listQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "q": {
          "type": "string",
          "maxLength": 64
        },
        "kind": {
          "enum": [
            "human",
            "agent"
          ]
        },
        "include_disabled": {
          "enum": [
            "0",
            "1"
          ]
        },
        "limit": {
          "type": "string",
          "pattern": "^[0-9]{1,3}$",
          "description": "1-100; default 20."
        }
      }
    },
    "listResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members"
      ],
      "properties": {
        "members": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/adminMember"
          }
        }
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "display_name",
        "password"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^[a-z0-9_]{2,32}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
        }
      }
    },
    "createResponse": {
      "$ref": "#/$defs/adminMember"
    },
    "patchRequest": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "disabled": {
          "type": "boolean"
        }
      }
    },
    "passwordSelfRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_password",
        "new_password"
      ],
      "properties": {
        "old_password": {
          "type": "string"
        },
        "new_password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
        }
      }
    },
    "passwordResetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 128
        }
      }
    },
    "okResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      }
    }
  }
}
