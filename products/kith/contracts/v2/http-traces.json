{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kith://contracts/v2/http-traces.json",
  "title": "Trace full text v2 (B-13)",
  "description": "POST /api/rooms/:id/traces (agent bot token, room member): the summary becomes a kind=trace message through the normal send path; the full text is stored in R2 (binding TRACES) under the message id. GET /api/rooms/:id/traces/:message_id (any room member) returns it. Defined in docs/v2/milestones/W6.md §4.3.",
  "$defs": {
    "postRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_message_id",
        "summary"
      ],
      "properties": {
        "client_message_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "≤ 2048 UTF-8 bytes (v1 trace limit)"
        },
        "full": {
          "type": "string",
          "description": "≤ 1 MiB UTF-8"
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "postResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "seq",
        "full_stored"
      ],
      "properties": {
        "message_id": {
          "type": "string"
        },
        "seq": {
          "type": [
            "integer",
            "null"
          ]
        },
        "full_stored": {
          "type": "boolean"
        }
      }
    },
    "getResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "body"
      ],
      "properties": {
        "message_id": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    }
  }
}
