{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kith://contracts/v2/ws-server.json",
  "title": "WebSocket server frames v2",
  "description": "Same as contracts/ws-server-v1.json except: type=status may carry error_class (B-11; only on the operator's connection with body 'reply failed', W3 §4.1); type=draft (B-10, W5 §4.2) carries a hosted reply's cumulative text while it streams. Drafts are never persisted, never have a seq and never appear in /mcp/events (V2-INV-03).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "event"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seq",
            "kind",
            "body"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "enum": [
                "message",
                "trace"
              ]
            },
            "body": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "room_id": {
              "type": "string"
            },
            "sender_id": {
              "type": "string"
            },
            "thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "generation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "client_message_id": {
              "type": "string"
            },
            "origin": {
              "type": "string",
              "const": "local"
            },
            "created_at": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "member_id",
        "body"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "status"
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "error_class": {
          "enum": [
            "auth",
            "not_found",
            "bad_request",
            "context_length",
            "rate_limited",
            "overloaded",
            "content_filter",
            "timeout",
            "network",
            "protocol",
            "unknown"
          ],
          "description": "03 §2.3 LlmErrorClass. Present only with body 'reply failed' on the operator's socket."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "code"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "member_id",
        "generation_id",
        "text",
        "done"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "draft"
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        },
        "generation_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "description": "Full text so far (not a delta); at most 8192 UTF-8 bytes. The newest frame for a generation_id wins."
        },
        "done": {
          "const": false,
          "description": "Always false; the persisted event (same generation_id) replaces the draft."
        }
      }
    }
  ]
}
