{
  "project": "kith",
  "verified": false,
  "verifiedNote": "由原始碼推斷，尚未實際啟動；第一次執行時驗證並修正後改為 true。",
  "locale": "zh-TW",
  "colorSchemes": [
    "light",
    "dark"
  ],
  "apps": [
    {
      "name": "web",
      "kind": "spa",
      "cwd": "products/kith/web",
      "install": "npm ci",
      "start": "npm run dev -- --host 127.0.0.1 --port 5174 --strictPort",
      "env": {
        "KITH_API_ORIGIN": "http://127.0.0.1:8787"
      },
      "baseUrl": "http://127.0.0.1:5174",
      "ready": "/",
      "pages": [
        {
          "id": "login",
          "path": "/login"
        },
        {
          "id": "home",
          "path": "/"
        },
        {
          "id": "settings",
          "path": "/settings"
        },
        {
          "id": "console-rooms",
          "path": "/console/rooms"
        },
        {
          "id": "console-agents",
          "path": "/console/agents"
        },
        {
          "id": "console-people",
          "path": "/console/people"
        },
        {
          "id": "console-providers",
          "path": "/console/providers"
        }
      ]
    }
  ]
}
