{
  "name": "kith",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev-bind.mjs worker",
    "dev:frontend": "node scripts/dev-bind.mjs frontend",
    "dev:sidecar": "node scripts/run-sidecar-local.mjs",
    "check:live": "node scripts/check-live-prereqs.mjs",
    "db:migrate:local": "wrangler d1 migrations apply kith --local",
    "db:seed:local": "node scripts/bootstrap-local.mjs",
    "db:bootstrap:local": "node scripts/bootstrap-local.mjs && wrangler d1 execute kith --local --file=.wrangler/bootstrap-local.sql",
    "test": "vitest run --exclude 'test/m1/**' --exclude 'test/m2/**' --exclude 'test/m3/**' --exclude 'test/m4/**' --exclude 'test/m6/**' --exclude 'test/m7/**' --exclude 'test/sidecar/**' && npm run test:sidecar && npm run test:m1 && npm run test:m3 && npm run test:m4 && npm run test:m6 && npm run test:m7",
    "test:sidecar": "vitest run test/sidecar --environment node",
    "test:m1": "vitest run --config vitest.worker.config.ts --maxWorkers=1 --no-isolate",
    "test:m3": "vitest run --config vitest.m3.config.ts --maxWorkers=1 --no-isolate",
    "test:m4": "vitest run --config vitest.m4.config.ts --maxWorkers=1 --no-isolate",
    "test:m6": "vitest run --config vitest.m6.config.ts --maxWorkers=1 --no-isolate",
    "test:m7": "vitest run --config vitest.m7.config.ts --maxWorkers=1 --no-isolate",
    "lint": "tsc --noEmit",
    "e2e": "npm --prefix e2e run test --",
    "e2e:all": "KITH_E2E_SCOPE=full npm --prefix e2e run test --",
    "e2e:open": "npm --prefix e2e run open --",
    "e2e:validate": "npm --prefix e2e run validate --",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.13",
    "@cloudflare/workers-types": "5.20260920.1",
    "@types/node": "26.6.2",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260918.1": true,
    "esbuild@0.25.12": true
  }
}
