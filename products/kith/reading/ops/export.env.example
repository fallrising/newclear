# Paths/endpoint only, never put token values here. Copy outside Git, chmod 600.
# Both checkouts may share the same private remote, but must be separate directories.
KITH_EXPORT_REPO=/srv/private/kith/export
KITH_EXPORT_BRANCH=main
KITH_BASE_URL=https://kith.example
KITH_TOKEN_FILE=/srv/private/kith/secrets/export-token
