APP_DOMAIN=deck.example.com
APP_IMAGE=ghcr.io/fallrising/phark:sha-0000000000000000000000000000000000000000

# APP_ABUSE_IP_HMAC_SECRET is REQUIRED in production. The prod profile refuses
# to start with a missing, malformed, short, or committed development value,
# so this placeholder MUST be replaced before deploying.
#
# Generate a distinct random secret (unpadded base64url that decodes to exactly
# 32 bytes) with:
#   openssl rand -base64 32 | tr -d '=\n' | tr '+/' '-_'
#
# Keep it out of source control and logs. It is the key for domain-separated
# account/IP abuse subjects and signals; rotating it intentionally
# breaks correlation and resets effective partitions.
# The value below is only a non-secret placeholder, never a real secret.
APP_ABUSE_IP_HMAC_SECRET=replace-me-with-a-distinct-random-32-byte-base64url-value
