# syntax=docker/dockerfile:1
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /fleetd ./cmd/fleetd

FROM gcr.io/distroless/static:nonroot
COPY --from=build /fleetd /fleetd
USER nonroot:nonroot
ENTRYPOINT ["/fleetd"]
