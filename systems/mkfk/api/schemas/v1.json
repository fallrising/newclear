{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkfk.invalid/schemas/v1.json",
  "title": "mkfk HTTP/JSON v1 contracts",
  "$defs": {
    "decimalUint64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "decimalInt64": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,18})$"
    },
    "safeToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "topic": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "producerID": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
    },
    "wireRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_base64", "value_base64"],
      "properties": {
        "key_base64": {"type": ["string", "null"], "maxLength": 1398104, "contentEncoding": "base64"},
        "value_base64": {"type": "string", "maxLength": 1398104, "contentEncoding": "base64"}
      }
    },
    "topicPartition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "partition"],
      "properties": {
        "topic": {"$ref": "#/$defs/topic"},
        "partition": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "assignment": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/topicPartition"}
    },
    "openProducerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "partition", "producer_id", "expected_epoch", "request_id"],
      "properties": {
        "topic": {"$ref": "#/$defs/topic"},
        "partition": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "producer_id": {"$ref": "#/$defs/producerID"},
        "expected_epoch": {"$ref": "#/$defs/decimalInt64"},
        "request_id": {"$ref": "#/$defs/safeToken"}
      }
    },
    "openProducerResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["producer_id", "epoch", "leader_term"],
          "properties": {
            "producer_id": {"$ref": "#/$defs/producerID"},
            "epoch": {"$ref": "#/$defs/decimalUint64"},
            "leader_term": {"$ref": "#/$defs/decimalUint64"}
          }
        }
      }
    },
    "produceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "partition", "producer_id", "epoch", "first_sequence", "acks", "records"],
      "properties": {
        "topic": {"$ref": "#/$defs/topic"},
        "partition": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "producer_id": {"$ref": "#/$defs/producerID"},
        "epoch": {"$ref": "#/$defs/decimalUint64"},
        "first_sequence": {"$ref": "#/$defs/decimalUint64"},
        "acks": {"const": "all"},
        "records": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/wireRecord"}}
      }
    },
    "produceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_offset", "last_offset", "next_sequence", "duplicate", "leader_term"],
          "properties": {
            "base_offset": {"$ref": "#/$defs/decimalUint64"},
            "last_offset": {"$ref": "#/$defs/decimalUint64"},
            "next_sequence": {"$ref": "#/$defs/decimalUint64"},
            "duplicate": {"type": "boolean"},
            "leader_term": {"$ref": "#/$defs/decimalUint64"}
          }
        }
      }
    },
    "fetchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "partition", "offset", "max_bytes", "max_wait_ms"],
      "properties": {
        "topic": {"$ref": "#/$defs/topic"},
        "partition": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "offset": {"$ref": "#/$defs/decimalUint64"},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "max_wait_ms": {"type": "integer", "minimum": 0, "maximum": 5000}
      }
    },
    "fetchedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "key_base64", "value_base64", "append_timestamp_ms"],
      "properties": {
        "offset": {"$ref": "#/$defs/decimalUint64"},
        "key_base64": {"type": ["string", "null"], "contentEncoding": "base64"},
        "value_base64": {"type": "string", "contentEncoding": "base64"},
        "append_timestamp_ms": {"$ref": "#/$defs/decimalUint64"}
      }
    },
    "fetchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["records", "next_offset", "high_watermark", "log_end_offset", "leader_term"],
          "properties": {
            "records": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/fetchedRecord"}},
            "next_offset": {"$ref": "#/$defs/decimalUint64"},
            "high_watermark": {"$ref": "#/$defs/decimalUint64"},
            "log_end_offset": {"$ref": "#/$defs/decimalUint64"},
            "leader_term": {"$ref": "#/$defs/decimalUint64"}
          }
        }
      }
    },
    "joinGroupRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "subscription", "request_id"],
      "properties": {
        "member_id": {"$ref": "#/$defs/safeToken"},
        "subscription": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/topic"}},
        "request_id": {"$ref": "#/$defs/safeToken"}
      }
    },
    "joinGroupResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "state", "coordinator_term"],
          "properties": {
            "generation": {"$ref": "#/$defs/decimalUint64"},
            "state": {"enum": ["EMPTY", "PREPARING", "ASSIGNING", "STABLE"]},
            "coordinator_term": {"$ref": "#/$defs/decimalUint64"}
          }
        }
      }
    },
    "syncGroupRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "generation", "revoked"],
      "properties": {
        "member_id": {"$ref": "#/$defs/safeToken"},
        "generation": {"$ref": "#/$defs/decimalUint64"},
        "revoked": {"type": "boolean"}
      }
    },
    "syncGroupResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "state", "assignment"],
          "properties": {
            "generation": {"$ref": "#/$defs/decimalUint64"},
            "state": {"enum": ["PREPARING", "ASSIGNING", "STABLE"]},
            "assignment": {"$ref": "#/$defs/assignment"}
          }
        }
      }
    },
    "heartbeatRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "generation"],
      "properties": {
        "member_id": {"$ref": "#/$defs/safeToken"},
        "generation": {"$ref": "#/$defs/decimalUint64"}
      }
    },
    "heartbeatResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "state", "rebalance_required"],
          "properties": {
            "generation": {"$ref": "#/$defs/decimalUint64"},
            "state": {"enum": ["PREPARING", "ASSIGNING", "STABLE"]},
            "rebalance_required": {"type": "boolean"}
          }
        }
      }
    },
    "leaveGroupRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "generation", "request_id"],
      "properties": {
        "member_id": {"$ref": "#/$defs/safeToken"},
        "generation": {"$ref": "#/$defs/decimalUint64"},
        "request_id": {"$ref": "#/$defs/safeToken"}
      }
    },
    "leaveGroupResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["removed", "generation"],
          "properties": {
            "removed": {"type": "boolean"},
            "generation": {"$ref": "#/$defs/decimalUint64"}
          }
        }
      }
    },
    "offsetCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "partition", "offset"],
      "properties": {
        "topic": {"$ref": "#/$defs/topic"},
        "partition": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "offset": {"$ref": "#/$defs/decimalUint64"}
      }
    },
    "commitOffsetsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["member_id", "generation", "offsets", "request_id"],
      "properties": {
        "member_id": {"$ref": "#/$defs/safeToken"},
        "generation": {"$ref": "#/$defs/decimalUint64"},
        "offsets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/offsetCommit"}},
        "request_id": {"$ref": "#/$defs/safeToken"}
      }
    },
    "commitOffsetsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generation", "offsets"],
          "properties": {
            "generation": {"$ref": "#/$defs/decimalUint64"},
            "offsets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/offsetCommit"}}
          }
        }
      }
    },
    "getOffsetsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partitions"],
      "properties": {
        "partitions": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/topicPartition"}}
      }
    },
    "getOffsetsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offsets"],
          "properties": {
            "offsets": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["topic", "partition", "offset"],
                "properties": {
                  "topic": {"$ref": "#/$defs/topic"},
                  "partition": {"type": "integer", "minimum": 0, "maximum": 2147483647},
                  "offset": {"oneOf": [{"$ref": "#/$defs/decimalUint64"}, {"type": "null"}]}
                }
              }
            }
          }
        }
      }
    },
    "metadataResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cluster_id", "config_sha256", "brokers", "partitions", "coordinator"],
          "properties": {
            "cluster_id": {"$ref": "#/$defs/safeToken"},
            "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "brokers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "client_addr"], "properties": {"id": {"type": "integer", "minimum": 1}, "client_addr": {"type": "string"}}}},
            "partitions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["topic", "partition", "replicas", "leader_id", "leader_term"],
                "properties": {
                  "topic": {"$ref": "#/$defs/topic"},
                  "partition": {"type": "integer", "minimum": 0, "maximum": 2147483647},
                  "replicas": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
                  "leader_id": {"type": ["integer", "null"], "minimum": 1},
                  "leader_term": {"oneOf": [{"$ref": "#/$defs/decimalUint64"}, {"type": "null"}]}
                }
              }
            },
            "coordinator": {"type": ["integer", "null"], "minimum": 1}
          }
        }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "error"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safeToken"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "outcome"],
          "properties": {
            "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
            "message": {"type": "string", "minLength": 1, "maxLength": 512},
            "retryable": {"type": "boolean"},
            "outcome": {"enum": ["not_applied", "unknown", "applied", "not_applicable"]},
            "details": {"type": "object", "maxProperties": 16}
          }
        }
      }
    }
  }
}
