{
  "project": "ojbquay console",
  "verified": false,
  "verifiedNote": "由原始碼推斷，尚未實際啟動；第一次執行時驗證並修正後改為 true。",
  "locale": "zh-TW",
  "colorSchemes": [
    "light",
    "dark"
  ],
  "apps": [
    {
      "name": "console",
      "kind": "spa",
      "cwd": "systems/ojbquay/console-web",
      "install": "pnpm install",
      "start": "pnpm dev --host 127.0.0.1 --port 5173 --strictPort",
      "env": {},
      "baseUrl": "http://127.0.0.1:5173",
      "ready": "/",
      "pages": [
        {
          "id": "login",
          "path": "/login"
        },
        {
          "id": "dashboard",
          "path": "/dashboard"
        },
        {
          "id": "topics",
          "path": "/topics"
        },
        {
          "id": "groups",
          "path": "/groups"
        },
        {
          "id": "subscriptions",
          "path": "/subscriptions"
        },
        {
          "id": "delay",
          "path": "/delay"
        }
      ]
    }
  ]
}
