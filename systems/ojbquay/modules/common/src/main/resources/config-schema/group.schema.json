{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ojbquay.dev/schema/config/group-v1.json",
  "title": "GroupConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "token",
    "owner",
    "enabled"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
