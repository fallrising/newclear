{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ojbquay.dev/schema/config/topic-v1.json",
  "title": "TopicConfig v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "clusterId",
    "partitions",
    "replication",
    "delayTopic",
    "maxMessageBytes",
    "retentionMs",
    "produceQuotaTps",
    "token",
    "owner",
    "enabled"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "clusterId": {
      "type": "integer",
      "minimum": 1
    },
    "partitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "replication": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "delayTopic": {
      "type": "boolean"
    },
    "maxMessageBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "retentionMs": {
      "type": "integer",
      "minimum": 1
    },
    "produceQuotaTps": {
      "type": "integer",
      "minimum": 1
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
