# Secure MQTT local development environment
# Keyring is self-managed (FileKeyringProvider) — swap brokers without changing keys.
# For public EMQX synthetic smoke see .env.public-dev.example

SECURE_MQTT_PROFILE=local-dev
SECURE_MQTT_BROKER_HOST=localhost
SECURE_MQTT_BROKER_PORT=8883
SECURE_MQTT_CLIENT_ID=secure-mqtt-client

SECURE_MQTT_TLS_CA_FILE=./certs/ca.pem
SECURE_MQTT_TLS_CERT_FILE=./certs/client.pem
SECURE_MQTT_TLS_KEY_FILE=./certs/client.key
SECURE_MQTT_TLS_SERVER_HOSTNAME=localhost

SECURE_MQTT_KEYRING_PATH=./.secure_mqtt/keyring.json
SECURE_MQTT_PUBLIC_KEYS_FILE=./config/public-keys.local.json
SECURE_MQTT_POLICY_FILE=./config/topic-policies.example.toml
SECURE_MQTT_DB_PATH=./.secure_mqtt/state.db