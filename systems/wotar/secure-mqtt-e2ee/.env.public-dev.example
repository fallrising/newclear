# Synthetic public EMQX smoke profile (NOT for real data)
SECURE_MQTT_PROFILE=public-dev
SECURE_MQTT_BROKER_HOST=broker.emqx.io
SECURE_MQTT_BROKER_PORT=8883
SECURE_MQTT_CLIENT_ID=secure-mqtt-public-smoke

# System CA bundle (Debian/Ubuntu path shown; override as needed)
SECURE_MQTT_TLS_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# No client cert for anonymous public broker TLS
# SECURE_MQTT_TLS_CERT_FILE=
# SECURE_MQTT_TLS_KEY_FILE=
SECURE_MQTT_TLS_SERVER_HOSTNAME=broker.emqx.io

# Same self-managed keyring as local-dev — crypto is broker-independent
SECURE_MQTT_KEYRING_PATH=./.secure_mqtt/keyring.json
SECURE_MQTT_PUBLIC_KEYS_FILE=./config/public-keys.local.json
SECURE_MQTT_POLICY_FILE=./config/topic-policies.example.toml
SECURE_MQTT_DB_PATH=./.secure_mqtt/public-smoke-state.db

# Opt-in gate for pytest -m public_smoke
SECURE_MQTT_RUN_PUBLIC_SMOKE=1
