{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gameplay pattern frontmatter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "title_en",
    "category",
    "tags",
    "summary",
    "related",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title_en": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "category": {
      "type": "string",
      "enum": [
        "farming",
        "fishing",
        "cooking",
        "gathering",
        "automation",
        "building",
        "inventory",
        "puzzles",
        "combat",
        "exploration",
        "relationships",
        "allocation",
        "commerce"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "related": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "accessed",
          "access_method"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s<>\"\\\\?#]+$"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "access_method": {
            "enum": [
              "page-text",
              "search-index-excerpt"
            ]
          }
        }
      }
    }
  }
}
