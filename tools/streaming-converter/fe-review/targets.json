{
  "project": "streaming-converter",
  "verified": false,
  "verifiedNote": "由原始碼推斷，尚未實際啟動；第一次執行時驗證並修正後改為 true。",
  "locale": "zh-TW",
  "colorSchemes": [
    "light",
    "dark"
  ],
  "apps": [
    {
      "name": "player",
      "kind": "server",
      "cwd": "tools/streaming-converter",
      "install": "(none)",
      "start": "python3 -m http.server 8088 --bind 127.0.0.1 --directory www",
      "env": {},
      "baseUrl": "http://127.0.0.1:8088",
      "ready": "/",
      "pages": [
        {
          "id": "player",
          "path": "/index.html"
        }
      ]
    }
  ]
}
